# Supabase credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication and integration credentials
AUTH_SECRET=
INTEGRATION_API_KEY=change-this-secret-key

# AI provider credentials
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Follow-up email: Gmail (address + app password) is used when set,
# otherwise the Resend API (EMAIL_API_KEY + EMAIL_FROM)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_API_KEY=
EMAIL_FROM=

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Retell AI credentials
RETELL_API_KEY=
# Dedicated website voice lead-capture agent
RETELL_AGENT_ID=
# Dedicated outbound appointment callback agent (must be different)
RETELL_CALLBACK_AGENT_ID=
RETELL_PHONE_NUMBER=
DENTAL_CLINIC_NAME=BrightSmile Dental Center

# Backend application and server configuration
PORT=5000
FRONTEND_URL=https://dental-crm-lovat.vercel.app
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$|^http://(localhost|127\.0\.0\.1):[0-9]+$

# Frontend API configuration
VITE_API_BASE_URL=https://dental-crm-neg8.onrender.com/api
